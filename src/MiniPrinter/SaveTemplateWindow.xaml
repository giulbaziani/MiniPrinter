<Window x:Class="MiniPrinter.SaveTemplateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="460" SizeToContent="Height" MinHeight="240" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" Background="{StaticResource Bg}">
  <StackPanel Margin="20">
    <TextBlock x:Name="TitleText" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,6"/>
    <TextBlock x:Name="PromptText" Foreground="{StaticResource Muted}" Margin="0,0,0,10"/>
    <TextBox x:Name="NameBox"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button x:Name="CancelBtn" Style="{StaticResource GhostButton}" MinWidth="110" Padding="16,10" Margin="0,0,10,0" Click="Cancel_Click"/>
      <Button x:Name="OkBtn" Style="{StaticResource PrimaryButton}" MinWidth="110" Padding="16,10" Click="Ok_Click"/>
    </StackPanel>
  </StackPanel>
</Window>
